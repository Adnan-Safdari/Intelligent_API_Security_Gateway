# Redis -- the notepad the gateway and this agent share
IASG_REDIS_URL=redis://localhost:6379/0

# The stream the gateway's evidence lands in
IASG_EVIDENCE_STREAM=attack_events
IASG_CONSUMER_GROUP=iasg-agent
IASG_CONSUMER_NAME=agent-1
IASG_BATCH_SIZE=500

# How often the control plane wakes up (proposal says 30-60s)
IASG_INTERVAL_SECONDS=30

# Policy writing and its safety rails
IASG_POLICY_PREFIX=policy:
IASG_MAX_IPS_PER_CYCLE=50
IASG_DRY_RUN=false

# Narrative generation. "null" = offline template, no LLM needed.
# Set to "ollama" once `ollama serve` is running and a model is pulled.
IASG_LLM_PROVIDER=null
IASG_OLLAMA_URL=http://localhost:11434
IASG_OLLAMA_MODEL=llama3.2

# Optional -- leave commented out until the compose stack is up
# IASG_POSTGRES_URL=postgresql://iasg_user:changeme@localhost:5434/iasg
