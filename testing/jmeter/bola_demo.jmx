          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Count 200 and 429">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def key = prev.getResponseCode() == '429' ? 'th_429' : (prev.getResponseCode() == '200' ? 'th_200' : 'th_other')
vars.put(key, String.valueOf(((vars.get(key) ?: '0') as int) + 1))
// 429 is the expected outcome once the policy is active, not an error.
prev.setSuccessful(prev.getResponseCode() in ['200', '429'])
</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Throttle result: control-plane policy enforced">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
int ok = (vars.get('th_200') ?: '0') as int
int limited = (vars.get('th_429') ?: '0') as int
def line = "after the policy wait: ${ok} x 200, ${limited} x 429 on GET /api/orders/{id}"
log.info('[bola] ' + line)
SampleResult.setResponseData(line, 'UTF-8')
SampleResult.setResponseMessage(line)
if (limited == 0) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage(line + ' -- no throttle. Is ATTACKER_IP trusted (run inside the Compose network), public, and not already used?')
}
</stringProp>
              <stringProp name="parameters"></stringProp>
