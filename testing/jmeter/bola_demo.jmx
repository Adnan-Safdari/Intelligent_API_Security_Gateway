          </hashTree>
        
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Split own ids for re-reading">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def ids = (vars.get('own_ids') ?: '').split(',').findAll { it }
ids.eachWithIndex { id, i -&gt; vars.put("own_id_${i + 1}", id) }
SampleResult.setIgnore()
</stringProp>
