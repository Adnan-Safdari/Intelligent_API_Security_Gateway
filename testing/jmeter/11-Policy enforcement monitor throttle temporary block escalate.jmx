<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="IASG Step 11 - Policy enforcement verifier">
      <stringProp name="TestPlan.comments">Step 11 - create a campaign, select a response, then verify enforcement.

Do not assume a policy already exists. Phase 1 creates the same coordinated three-IP route-scanning campaign as Step 9 and Step 10. Phase 2 waits for the campaign and gives time to use Campaigns or Policy. Phase 3 checks the result from IP 198.51.100.21.

Before each run, clear campaigns and delete active policies for .21, .22, and .23. A console reset does not remove a live Redis policy.

VERIFY_MODE values:
monitor: choose Monitor or make no response instruction. Set DASHBOARD_ACTION_WAIT_MS=0 for the quickest run. One normal request expects 404 because /admin is intentionally absent.
throttle: during the dashboard-action window choose Throttle. The plan consumes THROTTLE_REQUESTS quota tokens, then requires 429 and Retry-After.
temp_block: during the dashboard-action window choose Temporary block. One follow-up requires 403.
escalate: during the dashboard-action window choose Escalate. Campaigns and Policy audit prove escalation; the current gateway treats an active escalate policy as a bounded 403 denial, so the default post-action check expects 403.

Use the same method and path as the policy scope. GET /admin is the default because it is the dominant shared scan path used to form this campaign.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(PORT,8082)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="TARGET_IP" elementType="Argument"><stringProp name="Argument.name">TARGET_IP</stringProp><stringProp name="Argument.value">${__P(TARGET_IP,198.51.100.21)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="PROTECTED_PATH" elementType="Argument"><stringProp name="Argument.name">PROTECTED_PATH</stringProp><stringProp name="Argument.value">${__P(PROTECTED_PATH,/admin)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="VERIFY_MODE" elementType="Argument"><stringProp name="Argument.name">VERIFY_MODE</stringProp><stringProp name="Argument.value">${__P(VERIFY_MODE,monitor)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="SETUP_REQUESTS" elementType="Argument"><stringProp name="Argument.name">SETUP_REQUESTS</stringProp><stringProp name="Argument.value">${__P(SETUP_REQUESTS,8)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="REPEAT_REQUESTS" elementType="Argument"><stringProp name="Argument.name">REPEAT_REQUESTS</stringProp><stringProp name="Argument.value">${__P(REPEAT_REQUESTS,6)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="CAMPAIGN_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">CAMPAIGN_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(CAMPAIGN_WAIT_MS,45000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="DASHBOARD_ACTION_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">DASHBOARD_ACTION_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(DASHBOARD_ACTION_WAIT_MS,60000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="POLICY_PROPAGATION_WAIT_MS" elementType="Argument"><stringProp name="Argument.name">POLICY_PROPAGATION_WAIT_MS</stringProp><stringProp name="Argument.value">${__P(POLICY_PROPAGATION_WAIT_MS,7000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="THROTTLE_REQUESTS" elementType="Argument"><stringProp name="Argument.name">THROTTLE_REQUESTS</stringProp><stringProp name="Argument.value">${__P(THROTTLE_REQUESTS,40)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="MONITOR_EXPECTED_STATUS" elementType="Argument"><stringProp name="Argument.name">MONITOR_EXPECTED_STATUS</stringProp><stringProp name="Argument.value">${__P(MONITOR_EXPECTED_STATUS,404)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="ESCALATE_EXPECTED_STATUS" elementType="Argument"><stringProp name="Argument.name">ESCALATE_EXPECTED_STATUS</stringProp><stringProp name="Argument.value">${__P(ESCALATE_EXPECTED_STATUS,403)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="One policy-enforcement verifier"><intProp name="ThreadGroup.num_threads">1</intProp><intProp name="ThreadGroup.ramp_time">1</intProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Run selected verifier once"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp></ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Simulated source identity" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Forwarded-For</stringProp><stringProp name="Header.value">${TARGET_IP}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">iasg-policy-enforcement-verifier/1.0</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Phase 1A - eight distinct scan paths"><stringProp name="LoopController.loops">${SETUP_REQUESTS}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A distinct route - expect 404" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${SCAN_PATH_A}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose next A route" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def paths = ['/admin','/debug','/api/v1/users','/internal','/phpmyadmin','/server-status','/actuator','/api/admin']; def i = (vars.get('scanIndexA') ?: '0') as int; vars.put('SCAN_PATH_A', paths[i % paths.size()]); vars.put('scanIndexA', (i + 1).toString())</stringProp><stringProp name="cacheKey">true</stringProp></JSR223PreProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert A setup 404" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '404') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected 404 during campaign construction; got ' + prev.getResponseCode() + '. Delete any live policy before rerunning.') }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Phase 1A - shared /admin evidence"><stringProp name="LoopController.loops">${REPEAT_REQUESTS}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A shared /admin - expect 404" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert A shared 404" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '404') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected 404 during campaign construction; got ' + prev.getResponseCode()) }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Phase 2 - wait for campaign correlation" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${CAMPAIGN_WAIT_MS}</stringProp></TestAction><hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Phase 2 - dashboard response window" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${DASHBOARD_ACTION_WAIT_MS}</stringProp></TestAction><hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Wait for gateway policy snapshot refresh" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${POLICY_PROPAGATION_WAIT_MS}</stringProp></TestAction><hashTree/>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Monitor verification" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('VERIFY_MODE') == 'monitor')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Monitor follow-up - policy must not interfere" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
          <hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert monitor response" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def expected = vars.get('MONITOR_EXPECTED_STATUS'); if (prev.getResponseCode() != expected) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Monitor expected HTTP ' + expected + ' but got ' + prev.getResponseCode() + '. A policy may still be active.') }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree>
        </hashTree>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Throttle verification" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('VERIFY_MODE') == 'throttle')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
        <hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Consume throttle allowance"><stringProp name="LoopController.loops">${THROTTLE_REQUESTS}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
          <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Throttle allowance request" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree/></hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Throttle final request - expect 429" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy>
          <hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert 429 and Retry-After" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '429') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected HTTP 429 after consuming quota; got ' + prev.getResponseCode()) } else if (!(prev.getResponseHeaders() =~ /(?im)^Retry-After:\\s*\\d+/)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('HTTP 429 did not include a numeric Retry-After header') }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree>
        </hashTree>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Temporary-block verification" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('VERIFY_MODE') == 'temp_block')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Temporary-block follow-up - expect 403" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert 403 temporary block" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '403') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected HTTP 403 from temporary block; got ' + prev.getResponseCode()) }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Escalation post-action probe" enabled="true"><stringProp name="IfController.condition">${__groovy(vars.get('VERIFY_MODE') == 'escalate')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Post-escalation bounded-action probe" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Optionally assert escalation outcome" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def expected = (vars.get('ESCALATE_EXPECTED_STATUS') ?: '').trim(); if (expected &amp;&amp; prev.getResponseCode() != expected) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Escalation follow-up expected HTTP ' + expected + ' but got ' + prev.getResponseCode()) }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>

        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report"><boolProp name="ResultCollector.error_logging">false</boolProp><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><encoding>false</encoding><assertions>true</assertions><subresults>false</subresults><responseData>false</responseData><samplerData>false</samplerData><xml>false</xml><fieldNames>true</fieldNames><responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders><responseDataOnError>false</responseDataOnError><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><assertionsResultsToSave>0</assertionsResultsToSave><bytes>true</bytes><sentBytes>true</sentBytes><threadCounts>true</threadCounts><idleTime>true</idleTime><connectTime>true</connectTime></value></objProp><stringProp name="filename"></stringProp></ResultCollector><hashTree/>
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree"><boolProp name="ResultCollector.error_logging">false</boolProp><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><encoding>false</encoding><assertions>true</assertions><subresults>false</subresults><responseData>true</responseData><samplerData>true</samplerData><xml>false</xml><fieldNames>true</fieldNames><responseHeaders>true</responseHeaders><requestHeaders>true</requestHeaders><responseDataOnError>true</responseDataOnError><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><assertionsResultsToSave>0</assertionsResultsToSave><bytes>true</bytes><sentBytes>true</sentBytes><threadCounts>true</threadCounts><idleTime>true</idleTime><connectTime>true</connectTime></value></objProp><stringProp name="filename"></stringProp></ResultCollector><hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Phase 1B - IP 198.51.100.22 evidence"><intProp name="ThreadGroup.num_threads">1</intProp><intProp name="ThreadGroup.ramp_time">1</intProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Run B once"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp></ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Identity B" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Forwarded-For</stringProp><stringProp name="Header.value">198.51.100.22</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">User-Agent</stringProp><stringProp name="Header.value">iasg-policy-enforcement-verifier/1.0</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="B eight distinct paths"><stringProp name="LoopController.loops">${SETUP_REQUESTS}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B distinct route - expect 404" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${SCAN_PATH_B}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose next B route" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def paths = ['/admin','/debug','/api/v1/users','/internal','/phpmyadmin','/server-status','/actuator','/api/admin']; def i = (vars.get('scanIndexB') ?: '0') as int; vars.put('SCAN_PATH_B', paths[i % paths.size()]); vars.put('scanIndexB', (i + 1).toString())</stringProp><stringProp name="cacheKey">true</stringProp></JSR223PreProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert B setup 404" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '404') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected 404 during campaign construction; got ' + prev.getResponseCode()) }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="B shared /admin evidence"><stringProp name="LoopController.loops">${REPEAT_REQUESTS}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
        <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B shared /admin - expect 404" enabled="true"><intProp name="HTTPSampler.connect_timeout">3000</intProp><intProp name="HTTPSampler.response_timeout">5000</intProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PROTECTED_PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters"><collectionProp name="Arguments.arguments"/></elementProp></HTTPSamplerProxy><hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert B shared 404" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (prev.getResponseCode() != '404') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected 404 during campaign construction; got ' + prev.getResponseCode()) }</stringProp><stringProp name="cacheKey">true</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Phase 1C - IP 198.51.100.23 evidence"><intProp name="ThreadGroup.num_threads">1</intProp><intProp name="ThreadGroup.ramp_time">1</intProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Run C once"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp></ThreadGroup>
      <hashTree>
