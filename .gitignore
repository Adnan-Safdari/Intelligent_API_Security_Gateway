# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/
node_modules/

# Go workspace file
go.work

# Environment files (keep examples)
.env
.env.local
.env.*.local
*.env
!*.env.example

# Config files (keep examples)
configs/config.yaml
configs/*.yaml
!configs/*.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
.next/

# JMeter test assets
testing/jmeter/
# Keep the maintained FR3 verification plan under version control.
!testing/
!testing/jmeter/
testing/jmeter/*
!testing/jmeter/adaptive_rate_limit.jmx

# Database
*.db
*.sqlite
*.sqlite3

# Docker
docker-compose.override.yml

# Build artifacts
cmd/gateway/gateway

# Py related
.venv/
requirements.txt !/gateway/requirements.txt
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated build intermediates
build/
.claude/settings.json

# Raw capture from an anomaly dataset run: hundreds of megabytes of JSONL,
# reproducible from a rerun, and containing every request path a run drove.
# datasets/v1/ is deliberately not ignored -- the frozen dataset is the
# artefact, and its manifest is what makes it checkable.
datasets/raw/

# Trained model binaries: exactly reproducible from a frozen dataset and a
# fixed seed, so the artefact worth keeping is the metadata beside them.
# datasets/raw/ is ignored for the same reason.
models/**/*.joblib
