{
  "name": "iasg-desktop",
  "productName": "IASG",
  "version": "0.0.0",
  "description": "Desktop launcher for the Intelligent API Security Gateway",
  "main": "main.js",
  "private": true,
  "author": "IASG team",
  "scripts": {
    "start": "node node_modules/electron/install.js && electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.adnansafdari.iasg",
    "publish": null,
    "productName": "IASG",
    "files": [
      "main.js",
      "preload.js",
      "status.html",
      "status.js",
      "assets/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "IASG team <iasg@users.noreply.github.com>",
      "synopsis": "Desktop launcher for the Intelligent API Security Gateway"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "iasgRepo": "Adnan-Safdari/Intelligent_API_Security_Gateway",
  "homepage": "https://github.com/Pranav-Hirawat/Intelligent_API_Security_Gateway"
}
